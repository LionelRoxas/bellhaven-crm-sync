# Copy to .env.local and fill in. .env.local is git-ignored; never commit a real token.
CRM_API_BASE=
CRM_TOKEN=
# Optional overrides (defaults are in src/config.ts)
SITE_BASE=
BELLHAVEN_PARENT_NAME=
DB_PATH=
# Optional: your CRM browser URL (it contains the token, so keep it local); adds a link in the app header
CRM_BROWSER_URL=
# Optional: advisory AI second opinion on create/stale suggestions (Groq). Leave empty to turn it off.
GROQ_API_KEY=
# Optional model override (default openai/gpt-oss-120b)
GROQ_MODEL=
